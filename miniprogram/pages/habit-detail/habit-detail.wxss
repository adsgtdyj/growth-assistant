.page{min-height:100vh;background:linear-gradient(180deg,#f8fafc,#f1f5f9);display:flex;flex-direction:column;position:relative}
.status-pad{flex-shrink:0}

.nav-bar{flex-shrink:0;height:88rpx;display:flex;align-items:center;padding:0 24rpx;background:rgba(255,255,255,0.85);backdrop-filter:blur(20rpx);border-bottom:2rpx solid rgba(99,102,241,0.08)}
.nav-back{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;font-size:44rpx;color:#6366f1;font-weight:700;border-radius:20rpx}
.nav-title{flex:1;display:flex;align-items:center;justify-content:center;gap:12rpx;overflow:hidden}
.nav-icon{width:56rpx;height:56rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center;font-size:30rpx;flex-shrink:0;box-shadow:inset 0 2rpx 0 rgba(255,255,255,0.75)}
.nav-name{font-size:32rpx;font-weight:800;color:#1e293b;letter-spacing:-0.4rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:400rpx}
.nav-action{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;font-size:32rpx;color:#6366f1;font-weight:700;border-radius:20rpx;background:rgba(99,102,241,0.08)}

.main-area{flex:1;overflow:hidden}
.detail-page{height:100%;overflow-y:auto;padding-bottom:80rpx}

.detail-hero{padding:72rpx 48rpx 88rpx;text-align:center;color:#fff;border-radius:0 0 64rpx 64rpx;background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 30%,#ec4899 60%,#f43f5e 100%);box-shadow:0 32rpx 96rpx rgba(99,102,241,0.4)}
.streak-num{font-size:128rpx;font-weight:900;line-height:1;letter-spacing:-2rpx;text-shadow:0 8rpx 40rpx rgba(0,0,0,0.2)}
.streak-label{font-size:30rpx;opacity:0.92;margin-top:16rpx;font-weight:600}

.detail-data{background:rgba(255,255,255,0.9);padding:40rpx;border-radius:48rpx;margin:32rpx 40rpx;box-shadow:0 16rpx 64rpx rgba(99,102,241,0.12);border:2rpx solid rgba(255,255,255,0.8)}
.data-title{font-size:30rpx;font-weight:800;margin-bottom:24rpx;color:#1e293b}
.data-row{display:flex;justify-content:space-between;padding:24rpx 0;border-bottom:2rpx solid #f1f5f9;font-size:28rpx}
.data-row:last-child{border-bottom:none}
.data-label{color:#64748b;font-weight:600}
.data-value{color:#1e293b;font-weight:800}

.detail-records{background:rgba(255,255,255,0.9);padding:40rpx;border-radius:48rpx;margin:0 40rpx 32rpx;box-shadow:0 16rpx 64rpx rgba(99,102,241,0.12);border:2rpx solid rgba(255,255,255,0.8)}
.records-title{font-size:30rpx;font-weight:800;margin-bottom:24rpx;color:#1e293b}
.dcal-header{padding:0 0 24rpx;display:flex;align-items:center;justify-content:center;position:relative;height:72rpx}
.dcal-nav{position:absolute;width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;font-size:36rpx;color:#6366f1;font-weight:700;top:50%;transform:translateY(-50%)}
.dcal-nav:first-of-type{left:0}
.dcal-nav:last-of-type{right:0}
.dcal-title{font-size:32rpx;font-weight:800;color:#1e293b}

.cal-weekdays{display:flex;text-align:center;font-size:24rpx;color:#94a3b8;margin-bottom:12rpx;font-weight:700}
.cal-weekdays text{flex:1}
.cal-days{display:flex;flex-wrap:wrap;gap:8rpx}
.cal-day{width:calc((100% - 48rpx)/7);aspect-ratio:1;border-radius:20rpx;display:flex;align-items:center;justify-content:center;font-size:26rpx;color:#64748b;font-weight:700;background:rgba(255,255,255,0.6);position:relative}
.cal-day.empty{color:#cbd5e1;background:transparent}
.cal-day.level1{background:linear-gradient(135deg,rgba(99,102,241,0.2),rgba(139,92,246,0.3));color:#4f46e5}
.cal-day.level2{background:linear-gradient(135deg,rgba(99,102,241,0.4),rgba(139,92,246,0.5));color:#fff}
.cal-day.level3{background:linear-gradient(135deg,#6366f1,#8b5cf6,#ec4899);color:#fff}
.cal-day.today{font-weight:800;box-shadow:inset 0 0 0 4rpx rgba(99,102,241,0.45)}
.cal-day.has-note::after{content:'';position:absolute;bottom:8rpx;width:10rpx;height:10rpx;border-radius:5rpx;background:#ec4899}
.cal-day.selected{box-shadow:inset 0 0 0 4rpx #6366f1,0 8rpx 24rpx rgba(99,102,241,0.25)}

.detail-cal-note{margin-top:24rpx;padding:24rpx 28rpx;background:linear-gradient(135deg,rgba(99,102,241,0.06),rgba(236,72,153,0.06));border-radius:24rpx;border:2rpx solid rgba(99,102,241,0.12);animation:fadeIn 0.25s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(-8rpx)}to{opacity:1;transform:translateY(0)}}
.dcn-date{font-size:24rpx;color:#6366f1;font-weight:700;margin-bottom:16rpx}
.dcn-content{font-size:28rpx;color:#1e293b;line-height:1.6;font-weight:500}
.dcn-item{display:flex;align-items:center;justify-content:space-between;padding:16rpx 0;border-bottom:2rpx solid rgba(99,102,241,0.08)}
.dcn-item:last-child{border-bottom:none}
.dcn-item-body{flex:1;display:flex;align-items:center;gap:16rpx;flex-wrap:wrap;min-width:0}
.dcn-note{color:#1e293b;font-weight:600;word-break:break-all}
.dcn-time{font-size:24rpx;color:#6366f1;font-weight:700;flex-shrink:0}
.dcn-tag{font-size:22rpx;color:#f59e0b;background:rgba(245,158,11,0.12);padding:2rpx 12rpx;border-radius:8rpx;font-weight:700;flex-shrink:0}
.dcn-del{color:#ef4444;font-size:24rpx;font-weight:700;padding:8rpx 20rpx;border-radius:16rpx;background:rgba(239,68,68,0.08);flex-shrink:0}
.dcn-edit{color:#6366f1;font-size:24rpx;font-weight:700;padding:8rpx 20rpx;border-radius:16rpx;background:rgba(99,102,241,0.10);flex-shrink:0}
.dcn-item-actions{display:flex;gap:12rpx;margin-left:12rpx;flex-shrink:0}
.dcn-empty{padding:12rpx 0;color:#94a3b8;font-size:26rpx;font-weight:600;text-align:center}
.dcn-action{margin-top:16rpx;display:flex;gap:16rpx}
.dcn-btn{flex:1;padding:20rpx;border-radius:20rpx;background:linear-gradient(135deg,#6366f1,#8b5cf6,#ec4899);color:#fff;font-size:28rpx;font-weight:800;text-align:center;box-shadow:0 8rpx 32rpx rgba(99,102,241,0.3)}

.cal-legend{padding:20rpx 0 0;display:flex;align-items:center;gap:12rpx;font-size:22rpx;color:#94a3b8;font-weight:600;justify-content:center}
.legend-block{width:32rpx;height:20rpx;border-radius:8rpx}
.legend-block.l0{background:rgba(255,255,255,0.6);border:2rpx solid #e2e8f0}
.legend-block.l1{background:linear-gradient(135deg,rgba(99,102,241,0.2),rgba(139,92,246,0.3))}
.legend-block.l2{background:linear-gradient(135deg,rgba(99,102,241,0.4),rgba(139,92,246,0.5))}
.legend-block.l3{background:linear-gradient(135deg,#6366f1,#8b5cf6,#ec4899)}

/* 补签弹窗 */
.modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(15,23,42,0.55);display:flex;align-items:flex-end;justify-content:center;z-index:1000;animation:fadeIn 0.2s}
.makeup-sheet{width:100%;background:#fff;border-radius:48rpx 48rpx 0 0;padding:24rpx 40rpx 60rpx;animation:slideUp 0.3s cubic-bezier(0.4,0,0.2,1)}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.sheet-handle{width:80rpx;height:8rpx;background:#e2e8f0;border-radius:4rpx;margin:0 auto 24rpx}
.sheet-title{font-size:36rpx;font-weight:800;color:#1e293b;text-align:center;margin-bottom:12rpx}
.sheet-desc{font-size:26rpx;color:#64748b;text-align:center;margin-bottom:32rpx;font-weight:500}
.makeup-label{font-size:26rpx;font-weight:700;color:#475569;margin-bottom:12rpx;margin-top:20rpx}
.date-picker{padding:24rpx 28rpx;background:#f8fafc;border-radius:20rpx;border:2rpx solid #e2e8f0}
.date-value{font-size:28rpx;color:#1e293b;font-weight:600}
.note-input{padding:24rpx 28rpx;background:#f8fafc;border-radius:20rpx;border:2rpx solid #e2e8f0;font-size:28rpx;min-height:120rpx;width:100%;box-sizing:border-box}
.btn-confirm{margin-top:32rpx;padding:28rpx;border-radius:24rpx;background:linear-gradient(135deg,#6366f1,#8b5cf6,#ec4899);color:#fff;font-size:30rpx;font-weight:800;text-align:center;box-shadow:0 12rpx 40rpx rgba(99,102,241,0.35)}
.btn-cancel{margin-top:16rpx;padding:24rpx;color:#64748b;font-size:28rpx;font-weight:700;text-align:center}
