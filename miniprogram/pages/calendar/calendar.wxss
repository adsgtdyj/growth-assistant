.page{min-height:100vh;background:linear-gradient(180deg,#f8fafc,#f1f5f9);display:flex;flex-direction:column;position:relative}
.status-pad{flex-shrink:0}
.main-area{flex:1;overflow:hidden}
.cal-page{height:100%;overflow-y:auto;padding-bottom:240rpx}
.cal-header{padding:40rpx 48rpx;display:flex;align-items:center;justify-content:center;position:relative}
.month-nav{position:absolute;width:80rpx;height:80rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center}
.month-nav:first-child{left:40rpx}
.month-nav:last-child{right:40rpx}
.month-nav text{font-size:40rpx;color:#6366f1;font-weight:700}
.month-title{font-size:40rpx;font-weight:800;letter-spacing:-0.6rpx;background:linear-gradient(135deg,#6366f1,#ec4899);-webkit-background-clip:text;background-clip:text;color:transparent}
.cal-grid{padding:0 40rpx}
.cal-weekdays{display:flex;text-align:center;font-size:24rpx;color:#94a3b8;margin-bottom:16rpx;font-weight:700}
.cal-weekdays text{flex:1}
.cal-days{display:flex;flex-wrap:wrap;gap:12rpx}
.cal-day{width:calc((100% - 72rpx)/7);aspect-ratio:1;border-radius:28rpx;display:flex;align-items:center;justify-content:center;font-size:28rpx;color:#64748b;font-weight:700;background:rgba(255,255,255,0.6);position:relative}
.cal-day.empty{color:#cbd5e1;background:transparent}
.cal-day.level1{background:linear-gradient(135deg,rgba(99,102,241,0.2),rgba(139,92,246,0.3));color:#4f46e5}
.cal-day.level2{background:linear-gradient(135deg,rgba(99,102,241,0.4),rgba(139,92,246,0.5));color:#fff}
.cal-day.level3{background:linear-gradient(135deg,#6366f1,#8b5cf6,#ec4899);color:#fff}
.cal-day.today{font-weight:800;box-shadow:inset 0 0 0 4rpx rgba(99,102,241,0.45)}
.cal-day.has-note::after{content:'';position:absolute;bottom:12rpx;width:12rpx;height:12rpx;border-radius:6rpx;background:#ec4899}
.cal-day.selected{box-shadow:inset 0 0 0 4rpx #6366f1,0 8rpx 24rpx rgba(99,102,241,0.25);transform:translateY(-2rpx)}
.cal-stats{background:rgba(255,255,255,0.85);border-radius:48rpx;margin:32rpx 40rpx;padding:36rpx 40rpx;box-shadow:0 16rpx 64rpx rgba(99,102,241,0.1)}
.stat-row{display:flex;justify-content:space-between;align-items:center}
.stat-text{font-size:30rpx;color:#64748b;font-weight:600}
.stat-pct{font-size:36rpx;font-weight:800}
.stat-pct.purple{background:linear-gradient(135deg,#6366f1,#ec4899);-webkit-background-clip:text;background-clip:text;color:transparent}
.cal-legend{padding:0 48rpx 24rpx;display:flex;align-items:center;gap:16rpx;font-size:22rpx;color:#94a3b8;font-weight:600}
.legend-block{width:36rpx;height:24rpx;border-radius:8rpx}
.legend-block.l0{background:rgba(255,255,255,0.6)}
.legend-block.l1{background:linear-gradient(135deg,rgba(99,102,241,0.2),rgba(139,92,246,0.3))}
.legend-block.l2{background:linear-gradient(135deg,rgba(99,102,241,0.4),rgba(139,92,246,0.5))}
.legend-block.l3{background:linear-gradient(135deg,#6366f1,#8b5cf6,#ec4899)}
.day-detail-panel{margin:0 40rpx 32rpx;background:rgba(255,255,255,0.96);border-radius:48rpx;overflow:hidden;box-shadow:0 16rpx 64rpx rgba(99,102,241,0.15);border:2rpx solid rgba(255,255,255,0.8);animation:ddSlideIn 0.35s cubic-bezier(0.4,0,0.2,1)}
@keyframes ddSlideIn{from{opacity:0;transform:translateY(-16rpx)}to{opacity:1;transform:translateY(0)}}
.day-detail-header{display:flex;align-items:center;justify-content:space-between;padding:32rpx 40rpx;background:linear-gradient(135deg,rgba(99,102,241,0.08),rgba(236,72,153,0.08));border-bottom:2rpx solid rgba(99,102,241,0.1)}
.day-detail-title{font-size:30rpx;font-weight:800;color:#1e293b;letter-spacing:-0.4rpx}
.day-detail-close{width:56rpx;height:56rpx;border-radius:20rpx;background:rgba(0,0,0,0.06);display:flex;align-items:center;justify-content:center;font-size:32rpx;color:#94a3b8;font-weight:700;line-height:1}
.day-detail-list{padding:8rpx 40rpx 24rpx}
.day-detail-item{display:flex;align-items:center;gap:28rpx;padding:24rpx 0;border-bottom:2rpx solid #f1f5f9}
.day-detail-item:last-child{border-bottom:none}
.dd-icon{width:80rpx;height:80rpx;border-radius:28rpx;display:flex;align-items:center;justify-content:center;font-size:40rpx;flex-shrink:0;box-shadow:inset 0 2rpx 0 rgba(255,255,255,0.75)}
.dd-info{flex:1;min-width:0}
.dd-name{font-size:30rpx;font-weight:800;color:#1e293b}
.dd-note{font-size:26rpx;color:#94a3b8;margin-top:6rpx;font-weight:500;line-height:1.5;word-break:break-all}
.dd-time{font-size:26rpx;color:#6366f1;font-weight:800;flex-shrink:0}
.day-detail-empty{padding:64rpx 40rpx;text-align:center;font-size:28rpx;color:#94a3b8;font-weight:600}