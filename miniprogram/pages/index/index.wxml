<view class="page">
  <view class="status-pad" style="height:{{statusH}}"></view>

  <view class="main">
    <scroll-view class="scroll" scroll-y>

      <!-- 加载骨架 -->
      <block wx:if="{{loading}}">
        <view class="date-bar">
          <view><view class="date" style="width:200rpx;height:40rpx;background:#e2e8f0;border-radius:8rpx"></view></view>
          <view class="greeting" style="width:120rpx;height:28rpx;background:#e2e8f0;border-radius:8rpx;margin-top:8rpx"></view>
        </view>
      </block>

      <block wx:elif="{{showEmpty}}">
        <view class="date-bar">
          <view><view class="date">{{dateLabel}}</view></view>
          <view class="greeting">{{greeting}}</view>
        </view>
        <view class="empty-state">
          <view class="empty-icon"></view>
          <view class="empty-text">还没有习惯</view>
          <view class="empty-sub">点击下方按钮，开启你的第一个习惯</view>
          <view class="empty-create-btn" bindtap="onEmptyCreate">
            <text class="empty-plus">+</text>
            <text>创建习惯</text>
          </view>
        </view>
      </block>

      <block wx:else>
        <!-- 日期栏 -->
        <view class="date-bar">
          <view><view class="date">{{dateLabel}}</view></view>
          <view class="greeting">{{greeting}}</view>
        </view>

        <!-- 连胜横幅 -->
        <view class="streak-banner">
          <view class="streak-left">
            <text class="streak-icon">🔥</text>
            <view>
              <view class="streak-text">连胜 <text class="streak-num">{{totalStreak}}</text> 天</view>
              <view class="streak-sub">继续保持</view>
            </view>
          </view>
          <view class="streak-arrow">›</view>
        </view>

        <!-- AI建议卡片 -->
        <view class="ai-advice-card">
          <view class="advice-icon"></view>
          <text class="advice-text">{{greeting}}，今天的你还是一条好汉吗？</text>
        </view>

        <!-- 提醒卡片 -->
        <view class="reminder-card">
          <view class="remind-icon"></view>
          <view class="remind-info">
            <view class="remind-title">今日提醒</view>
            <view class="remind-time">{{reminderText}}</view>
            <view class="remind-sub">还有 {{uncheckedCount}} 个习惯未打卡</view>
          </view>
        </view>

        <!-- 习惯列表 -->
        <view class="habit-list">
          <view class="habit-card"
            wx:for="{{habits}}"
            wx:key="id"
            style="animation-delay:{{0.1 * (index + 1)}}s"
            bindtap="onHabitTap"
            data-id="{{item.id}}">
            <view class="card-top">
              <view class="habit-name">
                <view class="habit-icon-wrap" style="background:linear-gradient(135deg,{{item.color}}22,{{item.color}}38);box-shadow:inset 0 2rpx 0 rgba(255,255,255,0.7),0 6rpx 16rpx {{item.color}}2e">
                  <text class="habit-emoji">{{item.iconEmoji}}</text>
                </view>
                <text class="name">{{item.name}}</text>
              </view>
              <text class="streak-tag">🔥 {{item.streak}}天</text>
            </view>
            <view class="last-note">{{item.lastNote}}</view>
            <view class="card-actions">
              <view class="checkin-btn {{item.checkedToday ? 'done' : 'pending'}}"
                catchtap="onQuickCheckin" data-id="{{item.id}}">
                {{item.checkedToday ? '已打卡' : '打卡'}}
              </view>
              <view class="ai-link" catchtap="onAiLinkTap" data-id="{{item.id}}">问教练</view>
            </view>
          </view>
        </view>
      </block>

    </scroll-view>
  </view>

  <!-- 悬浮按钮 -->
  <view class="fab-btn" bindtap="onFabTap">
    <view class="fab-icon"></view>
  </view>

  <!-- 打卡底部弹窗 -->
  <view class="checkin-overlay" wx:if="{{checkinVisible}}" bindtap="onCheckinClose">
    <view class="checkin-sheet" catchtap="_noopTap">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view class="sheet-icon" style="background:linear-gradient(135deg,{{checkinHabit.color}}22,{{checkinHabit.color}}38)">
          <text>{{checkinHabit.iconEmoji}}</text>
        </view>
        <view class="sheet-title">{{checkinHabit.name}}</view>
        <view class="sheet-sub">{{checkinIsDone ? '今日已打卡 · 可更新备注' : '记录一下你的心得吧'}}</view>
      </view>

      <view class="note-wrap">
        <input class="note-input"
          placeholder="今天的感受、进度、小成就…（可选）"
          value="{{checkinNote}}"
          maxlength="100"
          confirm-type="done"
          bindinput="onCheckinNoteInput"/>
      </view>

      <view class="sheet-actions">
        <view class="btn-primary" bindtap="onCheckinConfirm">
          <text class="check-tick" wx:if="{{!checkinIsDone}}"></text>
          <text>{{checkinIsDone ? '保存备注' : '完成打卡'}}</text>
        </view>

        <view wx:if="{{checkinIsDone}}" class="btn-secondary btn-undo" bindtap="onCheckinUndo">撤销今日打卡</view>

        <view class="btn-row-2">
          <view class="btn-ghost" bindtap="onCheckinAskCoach">问教练</view>
          <view class="btn-ghost" wx:if="{{!checkinIsDone}}" bindtap="onCheckinLater">稍后再说</view>
          <view class="btn-ghost" wx:else bindtap="onCheckinSkip">关闭</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 劝留弹窗 -->
  <view class="duo-overlay" wx:if="{{duoVisible}}" bindtap="onDuoSkipToday">
    <view class="duo-modal" catchtap="_noopTap">
      <view class="duo-avatar">
        <text class="duo-face">🦉</text>
      </view>
      <view class="duo-msg">{{duoMsg}}</view>
      <view class="duo-sub">{{duoSub}}</view>
      <view class="duo-btn-primary" bindtap="onDuoGoCheckin">好，我这就去打卡</view>
      <view class="duo-btn-secondary" bindtap="onDuoSkipToday">今天真的不行</view>
    </view>
  </view>

  <!-- 打卡成功全屏动效 -->
  <view class="success-overlay" wx:if="{{successVisible}}" bindtap="onSuccessTap">
    <view class="success-inner">
      <view class="success-ring">
        <view class="success-check"></view>
      </view>
      <view class="success-streak">连胜 {{successStreak}} 天</view>
      <view class="success-msg">{{successMsg}}</view>
    </view>
  </view>
</view>
