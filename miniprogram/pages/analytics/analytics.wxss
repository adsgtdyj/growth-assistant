.page{min-height:100vh;background:linear-gradient(180deg,#f8fafc,#f1f5f9);display:flex;flex-direction:column;position:relative}
.status-pad{flex-shrink:0}
.main-area{flex:1;overflow:hidden}
.analytics-page{height:100%;overflow-y:auto;padding-bottom:280rpx}

.analytics-header{padding:28rpx 48rpx}
.header-title{font-size:52rpx;font-weight:900;letter-spacing:-1rpx;background:linear-gradient(135deg,#6366f1,#ec4899);-webkit-background-clip:text;background-clip:text;color:transparent;display:inline-flex;align-items:center;gap:12rpx}
.header-sub{font-size:28rpx;color:#64748b;margin-top:12rpx;font-weight:500}

/* KPI */
.kpi-row{display:grid;grid-template-columns:1fr 1fr;gap:28rpx;padding:0 40rpx 32rpx}
.kpi-card{background:rgba(255,255,255,0.9);border-radius:44rpx;padding:40rpx;text-align:center;box-shadow:0 16rpx 64rpx rgba(99,102,241,0.1);border:2rpx solid rgba(255,255,255,0.8)}
.kpi-num{font-size:64rpx;font-weight:900;line-height:1.1}
.kpi-num.dark{color:#1e293b}
.kpi-num.green{background:linear-gradient(135deg,#6366f1,#8b5cf6);-webkit-background-clip:text;background-clip:text;color:transparent}
.kpi-num.orange{background:linear-gradient(135deg,#f97316,#f43f5e);-webkit-background-clip:text;background-clip:text;color:transparent}
.kpi-num.purple{background:linear-gradient(135deg,#6366f1,#ec4899);-webkit-background-clip:text;background-clip:text;color:transparent}
.kpi-label{font-size:24rpx;color:#64748b;margin-top:16rpx;font-weight:600}
.kpi-trend{font-size:24rpx;margin-top:12rpx;color:#94a3b8;font-weight:600}

/* 图表卡片 */
.chart-section{padding:0 40rpx;margin-bottom:32rpx}
.chart-card{background:rgba(255,255,255,0.9);border-radius:48rpx;padding:40rpx;box-shadow:0 16rpx 64rpx rgba(99,102,241,0.1);border:2rpx solid rgba(255,255,255,0.8)}
.chart-card.chart-clickable:active{transform:scale(0.98);}
.chart-title{font-size:30rpx;font-weight:800;margin-bottom:32rpx;display:flex;align-items:center;gap:16rpx;color:#1e293b}
.chart-hint{margin-left:auto;font-size:22rpx;color:#94a3b8;font-weight:600}

.bar-chart{display:flex;align-items:flex-end;gap:16rpx;height:280rpx;padding-top:20rpx}
.bar-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:12rpx;justify-content:flex-end;height:100%}
.bar{width:100%;border-radius:20rpx 20rpx 8rpx 8rpx;background:linear-gradient(180deg,#6366f1,#8b5cf6)}
.bar-val{font-size:24rpx;color:#1e293b;font-weight:800}
.bar-label{font-size:22rpx;color:#94a3b8;font-weight:700}

/* 完成率对比 */
.compare-row{display:flex;align-items:center;justify-content:space-between;padding:24rpx 0;border-bottom:2rpx solid #f1f5f9}
.compare-row:last-child{border-bottom:none}
.compare-left{display:flex;align-items:center;gap:20rpx;flex-shrink:0}
.compare-icon{width:72rpx;height:72rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;font-size:36rpx}
.compare-name{font-size:28rpx;font-weight:700;color:#1e293b}
.compare-bar-wrap{flex:1;margin:0 24rpx;height:20rpx;background:linear-gradient(90deg,#f1f5f9,#e2e8f0);border-radius:10rpx;overflow:hidden}
.compare-bar-fill{height:100%;border-radius:10rpx;background:linear-gradient(90deg,#6366f1,#ec4899)}
.compare-pct{font-size:28rpx;font-weight:800;min-width:80rpx;text-align:right;color:#6366f1}

/* 智能洞察 */
.insight-card{background:rgba(255,255,255,0.9);border-radius:48rpx;padding:40rpx;margin:0 40rpx 32rpx;box-shadow:0 16rpx 64rpx rgba(99,102,241,0.1);border:2rpx solid rgba(255,255,255,0.8)}
.insight-title{font-size:30rpx;font-weight:800;margin-bottom:32rpx;display:flex;align-items:center;gap:16rpx;color:#1e293b}
.insight-item{padding:28rpx 0;border-bottom:2rpx solid #f1f5f9;display:flex;gap:24rpx;align-items:flex-start}
.insight-item:last-child{border-bottom:none}
.insight-icon{width:48rpx;height:48rpx;border-radius:16rpx;background:linear-gradient(135deg,rgba(99,102,241,0.15),rgba(236,72,153,0.15));display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#6366f1;font-weight:800;font-size:24rpx}
.insight-text{font-size:28rpx;color:#1e293b;line-height:1.7;font-weight:500}
.insight-text .hl{color:#6366f1;font-weight:800}

/* 记录引导 */
.analysis-guide{background:rgba(255,255,255,0.72);border-radius:44rpx;padding:32rpx 36rpx;margin:0 40rpx 32rpx;border:2rpx solid rgba(226,232,240,0.9);box-shadow:0 12rpx 48rpx rgba(99,102,241,0.06)}
.analysis-guide-title{font-size:28rpx;font-weight:800;color:#475569;margin-bottom:12rpx;display:flex;align-items:center;gap:16rpx}
.analysis-guide-text{font-size:26rpx;line-height:1.7;color:#94a3b8;font-weight:600}
.analysis-guide-actions{display:flex;gap:20rpx;margin-top:24rpx}
.analysis-guide-btn{flex:1;padding:20rpx 24rpx;border-radius:28rpx;background:#f8fafc;border:2rpx solid #e2e8f0;color:#64748b;font-size:26rpx;font-weight:800;text-align:center}
.analysis-guide-btn.primary{background:linear-gradient(135deg,rgba(99,102,241,0.12),rgba(236,72,153,0.12));border-color:rgba(99,102,241,0.25);color:#6366f1}

/* 图标 */
